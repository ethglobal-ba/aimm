# Caddy configuration for AIMM indexer
# Uses self-signed certificate for HTTPS on IP address

{
	# Disable automatic HTTPS since we're using IP address
	auto_https off
}

# HTTPS with self-signed cert for IP address access
:443 {
	# Use internal/self-signed TLS certificate
	tls internal

	# Reverse proxy to indexer service
	reverse_proxy indexer:42069

	# Enable compression
	encode gzip

	# Logging
	log {
		output stdout
		format console
	}
}

# HTTP also serves the indexer (no redirect)
:80 {
	# Reverse proxy to indexer service
	reverse_proxy indexer:42069

	# Enable compression
	encode gzip

	# Logging
	log {
		output stdout
		format console
	}
}
