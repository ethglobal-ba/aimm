{
  "name": "@workspace/aimm-sdk",
  "version": "0.0.0",
  "description": "Comprehensive SDK for AIMM - indexer data queries and contract interactions",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ponder/client": "^0.15.10",
    "@ponder/react": "^0.15.10",
    "@tanstack/react-query": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "wagmi": "^3.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "@types/react": "^18.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}